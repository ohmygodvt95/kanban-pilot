{
  "name": "kanban-pilot",
  "version": "0.2.0",
  "description": "KanbanPilot: local-first kanban board that drives coding agents (Claude Code, Codex, Copilot CLI) in git worktrees.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmygodvt95/kanban-pilot.git"
  },
  "homepage": "https://github.com/ohmygodvt95/kanban-pilot#readme",
  "bugs": "https://github.com/ohmygodvt95/kanban-pilot/issues",
  "bin": {
    "kanban-pilot": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "kanban",
    "coding-agent",
    "claude-code",
    "codex",
    "copilot",
    "git-worktree",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node -e \"for (const f of ['dist/bin.js','dist/web/index.html','templates/CLAUDE.md']) if (!require('fs').existsSync(f)) { console.error('missing ' + f + ': run pnpm build at the repo root first'); process.exit(1) }\""
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@hono/node-ws": "1.3.1",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.2",
    "execa": "10.0.1",
    "hono": "4.13.8",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "ulid": "3.0.2",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@agent-kanban/core": "workspace:*",
    "@agent-kanban/server": "workspace:*",
    "@agent-kanban/shared": "workspace:*",
    "@agent-kanban/web": "workspace:*",
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  },
  "agentKanban": true
}
