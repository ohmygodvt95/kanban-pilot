{
  "name": "@agent-kanban/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@agent-kanban/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --conditions=@agent-kanban/source src/dev.ts"
  },
  "dependencies": {
    "@agent-kanban/core": "workspace:*",
    "@agent-kanban/shared": "workspace:*",
    "@hono/node-server": "1.19.17",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.8",
    "pino": "10.3.1",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13"
  }
}
